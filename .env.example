# ============================================
# Azure OpenAI Configuration (Recommended)
# ============================================
USE_AZURE_OPENAI=True

# Azure OpenAI API Key
# Get from: Azure Portal > Your OpenAI Resource > Keys and Endpoint
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here

# Azure OpenAI Endpoint
# Format: https://your-resource-name.openai.azure.com/
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/

# Azure OpenAI Deployment Name
# This is the name you gave your GPT-4o deployment in Azure
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Azure OpenAI API Version
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ============================================
# Standard OpenAI Configuration (Alternative)
# ============================================
# If you want to use standard OpenAI instead of Azure, set USE_AZURE_OPENAI=False
# and configure the following:

# USE_AZURE_OPENAI=False
# OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# ============================================
# Example Azure Configuration:
# ============================================
# USE_AZURE_OPENAI=True
# AZURE_OPENAI_API_KEY=abc123def456ghi789jkl012mno345pqr678
# AZURE_OPENAI_ENDPOINT=https://my-company-openai.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-deployment
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

